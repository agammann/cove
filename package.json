{
  "name": "cove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx watch apps/api/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/build-hosted.mjs",
    "build:local": "vite build --config apps/web/vite.config.ts && tsc -p tsconfig.server.json",
    "test:sites": "vitest run tests/sites.test.ts",
    "start": "node dist/apps/api/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/database/migrate.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.3",
    "@better-auth/mcp": "1.7.3",
    "@better-auth/oauth-provider": "1.7.3",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "lucide-react": "1.42.0",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
