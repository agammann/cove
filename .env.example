NODE_ENV=development
PORT=4317
APP_URL=http://localhost:4317
DATABASE_URL=postgresql://cove:cove-local-only@localhost:55439/cove
# Generate your own random secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Cove <hello@localhost>
SMTP_USER=
SMTP_PASSWORD=
MAX_PROJECTS=50
MAX_REVISIONS=1000
MAX_STORAGE_BYTES=104857600
RATE_LIMIT=120
TRUST_PROXY=false


